{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/hermes/schemas/review-verdict.schema.json",
  "title": "Hermes V0 reviewer verdict",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "task_id",
    "reviewed_sha",
    "author_model",
    "reviewer_model",
    "reviewer_provider",
    "reviewer_route",
    "verdict",
    "reproduced_commands",
    "criteria",
    "findings",
    "mandatory_tests_skipped",
    "out_of_scope_files"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "run_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "reviewed_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "author_model": { "type": "string", "minLength": 1 },
    "reviewer_model": { "type": "string", "minLength": 1 },
    "reviewer_provider": { "type": "string", "minLength": 1 },
    "reviewer_route": { "type": "string", "minLength": 1 },
    "verdict": { "enum": ["APPROVED", "CHANGES_REQUESTED", "BLOCKED"] },
    "reproduced_commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command_id", "exit_code"],
        "properties": {
          "command_id": { "type": "string", "minLength": 1 },
          "exit_code": { "type": "integer" }
        }
      }
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion_id", "status", "evidence_refs"],
        "properties": {
          "criterion_id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["passed", "failed", "blocked"] },
          "evidence_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "summary", "reproduction"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["critical", "high", "medium", "low", "info"] },
          "summary": { "type": "string", "minLength": 1 },
          "reproduction": { "type": "string", "minLength": 1 }
        }
      }
    },
    "mandatory_tests_skipped": { "type": "integer", "minimum": 0 },
    "out_of_scope_files": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
  },
  "allOf": [
    {
      "if": { "properties": { "verdict": { "const": "APPROVED" } } },
      "then": {
        "properties": {
          "mandatory_tests_skipped": { "const": 0 },
          "out_of_scope_files": { "maxItems": 0 }
        }
      }
    }
  ]
}
